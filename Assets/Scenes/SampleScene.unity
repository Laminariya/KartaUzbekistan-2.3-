  m_EditorClassIdentifier: 
  textJuicer: {fileID: 0}
  textList:
  - "Buzilgan uy-joy va olib qo\u2018yilgan yer uchastkasi evaziga yer uchastkasi,
    uy-joy ajratish va kompensatsiya to\u2018lash"
  - "\u0412\u044B\u0434\u0435\u043B\u0435\u043D\u0438\u0435 \u0437\u0435\u043C\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0443\u0447\u0430\u0441\u0442\u043A\u0430, \u0436\u0438\u043B\u044C\u044F \u0438
    \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u0438 \u0432\u0437\u0430\u043C\u0435\u043D
    \u0441\u043D\u0435\u0441\u0435\u043D\u043D\u043E\u0433\u043E \u0436\u0438\u043B\u044C\u044F
    \u0438 \u0438\u0437\u044A\u044F\u0442\u043E\u0433\u043E \u0437\u0435\u043C\u0435\u043B\u044C\u043D\u043E\u0433\u043E
    \u0443\u0447\u0430\u0441\u0442\u043A\u0430"
